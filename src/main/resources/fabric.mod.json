{
  "schemaVersion": 1,
  "id": "fabrishot",
  "version": "${version}",
  "icon": "assets/fabrishot/icon.png",
  "environment": "client",
  "mixins": [
    "mixins.fabrishot.json"
  ],
  "entrypoints": {
    "main": [
      "me.ramidzkh.fabrishot.Fabrishot::initialize"
    ],
    "modmenu": [
      "me.ramidzkh.fabrishot.config.ModMenuBridge"
    ]
  },
  "name": "Fabrishot",
  "description": "Take high resolution screenshots because why not. Fork maintained by Fhxa3.",
  "depends": {
    "minecraft": ">=${minecraft_version}",
    "fabric-api": "*"
  },
  "recommends": {
    "modmenu": "*",
    "cloth-config2": "*"
  },
  "suggests": {
    "flashback": "*"
  },
  "authors": [
    "ramidzkh",
    "Fhxa3"
  ],
  "license": [
    "MIT"
  ],
  "contact": {
    "homepage": "https://github.com/Fhxa3/fabrishot#readme",
    "issues": "https://github.com/Fhxa3/fabrishot/issues",
    "sources": "https://github.com/Fhxa3/fabrishot"
  }
}
